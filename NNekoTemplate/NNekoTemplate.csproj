<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/14.0.2">
  <PropertyGroup>
    <Name>NNekoTemplate</Name>
    <Author>NaughtyNeko</Author>
    <Punchline></Punchline>
    <Description></Description>
    <Tags>NNeko,NaughtyNeko</Tags>
    <WarningLevel>4</WarningLevel>
    <PackageLicenseExpression>APGL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Version stamping (GitVersion supplied by CI workflow) -->
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Fallback version if GitVersion is not provided -->
    <Version>0.0.0</Version>

    <!-- These will be set by /p:GitVersion=1.2.3 in your workflow -->
    <AssemblyVersion>$(GitVersion)</AssemblyVersion>
    <FileVersion>$(GitVersion)</FileVersion>
    <InformationalVersion>$(GitVersion)</InformationalVersion>
  </PropertyGroup>


  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <CopyLocalLockfileAssemblies>true</CopyLocalLockfileAssemblies>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);IDE1006,CS8618,MSB3270</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include=".\images\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="CHANGELOG.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>

    <Content Include="Data\NNeko.png" />

    <Content Include="NNekoTemplate.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.1.0.22" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NNekoTemplate.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Data\NNeko.png" />
  </ItemGroup>
</Project>